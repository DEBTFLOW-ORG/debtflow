# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
VOICE_AGENT_URL=https://tu-dominio-publico-del-agente
# auto usa ElevenLabs si esta configurado; vapi/twilio fuerzan un proveedor
CALL_PROVIDER=auto

# JWT
JWT_SECRET=cambia_esto_en_produccion
JWT_EXPIRES_IN=7d

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# Twilio master account
TWILIO_MASTER_ACCOUNT_SID=ACxxxx
TWILIO_MASTER_AUTH_TOKEN=xxxx
TWILIO_PHONE_AREA_CODE=1
TWILIO_PHONE_NUMBER=+10000000000

# OpenAI
OPENAI_API_KEY=sk-xxxx

# Vapi
# Dashboard -> API Keys
VAPI_API_KEY=xxxx
# Dashboard -> Phone Numbers -> copia el ID del numero que usara las llamadas salientes
VAPI_PHONE_NUMBER_ID=xxxx
# Recomendado: crear una credencial en Vapi y usar el mismo secreto como Bearer o X-Vapi-Secret
VAPI_WEBHOOK_SECRET=xxxx
# Opcional: si usas Custom Credentials modernas en Vapi
VAPI_SERVER_CREDENTIAL_ID=cred_xxxx
VAPI_OPENAI_MODEL=gpt-4o-mini
VAPI_MODEL_TEMPERATURE=0.35
VAPI_MODEL_MAX_TOKENS=90
VAPI_TRANSCRIBER_MODEL=nova-3
VAPI_TRANSCRIBER_LANGUAGE=es
VAPI_MAX_DURATION_SECONDS=300

# ElevenLabs
# Conecta esta API key tambien en Vapi -> Integrations -> ElevenLabs
ELEVENLABS_API_KEY=xxxx
ELEVENLABS_AGENT_ID=agent_xxxx
# Opcional: si esta vacio, el backend intenta resolver/importar TWILIO_PHONE_NUMBER en ElevenLabs
ELEVENLABS_PHONE_NUMBER_ID=phnum_xxxx
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_STABILITY=0.28
ELEVENLABS_SIMILARITY_BOOST=0.86
ELEVENLABS_SPEED=1.08
ELEVENLABS_STYLE=0.35

# Encryption for Twilio tokens stored in DB
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=xxxx
